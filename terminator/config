[global_config]
  borderless = True
  dbus = False
  enabled_plugins = TerminatorThemes, LaunchpadCodeURLHandler, APTURLHandler, LaunchpadBugURLHandler
  focus = mouse
  geometry_hinting = True
[keybindings]
[layouts]
  [[default]]
    [[[child1]]]
      parent = window0
      profile = OneHalfDark
      type = Terminal
    [[[window0]]]
      parent = ""
      # size = 1000, 800
      type = Window
[plugins]
[profiles]
  [[default]]
    background_darkness = 0.89
    background_type = transparent
    cursor_color = "#ffffff"
    font = Consolas 12
    foreground_color = "#ffffff"
    scrollbar_position = hidden
    show_titlebar = False
    use_system_font = False
  [[OneHalfDark]]
    background_color = "#282c34"
    background_darkness = 0.89
    background_type = transparent
    cursor_color = "#a3b3cc"
    font = Terminus 12
    foreground_color = "#dcdfe4"
    palette = "#282c34:#e06c75:#98c379:#e5c07b:#61afef:#c678dd:#56b6c2:#dcdfe4:#282c34:#e06c75:#98c379:#e5c07b:#61afef:#c678dd:#56b6c2:#dcdfe4"
    scrollbar_position = hidden
    show_titlebar = False
    use_system_font = False
