set autoedit
set from='avensin@hotmail.com'
set realname='Thomas Aven'
set use_from
set mail_check=30
set timeout=60
set imap_keepalive=120
set imap_passive=no
set sleep_time=0
set editor="vim"
set sendmail="/usr/bin/msmtp"

alternative_order text/plain text/html
auto_view text/html application/html application/pdf application/msword application/word text/richtext

set record="=.sent"
set postponed="=.drafts"
set imap_list_subscribed=no
set header_cache="~/.mutt-headercache"

# Magic for automagic mailboxes
mailboxes `\
echo -n "+ "; \
for file in ~/Mail/.*; do \
	box=$(basename $file); \
	if [ ! $box = '.' -a ! $box = '..' -a ! $box = '.customflags' -a ! $box = '.subscriptions' -a ! $box = '.INBOX' ]; then \
		echo -n "+$box "; \
	fi; \
done`

# Sane macros for maildir-usage.
macro index c "<change-folder>?<toggle-mailboxes>" "open a different folder"
macro pager c "<change-folder>?<toggle-mailboxes>" "open a different folder"
macro index C "<copy-message>?<toggle-mailboxes>" "copy a message to a mailbox"
macro index M "<save-message>?<toggle-mailboxes>" "move a message to a mailbox"
macro index l "<tag-pattern>Mail delivery failed:<enter>;s/home/cassarossa/itk/thomaav/Mail/.itk-bounces/<enter>" "move bounces"


ignore *

unignore From
color header green default "From: "
unignore Reply-To
color header green default "From: "
unignore User-Agent
unignore X-Mailer
unignore X-MimeOLE

unignore Resent*

unignore To
color header red default "To: "

unignore Cc
unignore Bcc
color header red default "Cc: "
color header red default "Bc: "

unignore Subject
color header yellow default "Subject: "

unignore Date
color header magenta default "Date: "

unignore X-Spam-Score
unignore X-Spam-Report

set move=no

set copy=yes            # Lagre alle utgående mail
set delete=ask-yes      # Spør før en sletter meldinger
set include=yes         # alltid quote

set postpone=ask-yes    # spør når jeg avbryter skriving
set print=ask-no        # spør før printing. Stort sett tastefeil uansett. 
set edit_hdrs           # la meg få kontroll over headerene
set abort_unmodified    # drit i meldinger jeg ikke har lagret
set bounce_delivered=no # Fjern Delivered-To: header ved bouncing
set pager_index_lines=6 # splitscreen mutt!! ;)
set pager_stop=yes   # hopp til neste melding når du browser ferdig en gammel
set arrow_cursor=no  # bruk hele linjen som meny markør
set check_new=yes       # sjekk for nye meldinger i maildir og MH-style bokser.
set forward_quote=no # quote forwardinger?
set help=no	# slår av/på hjelp-headeren 
set indent_string="> "  # endre denne, og bli flamet til døde :)
set status_on_top # få status-linja til toppen
set mark_old=no	# Show old but unread messages
set menu_scroll=yes     # Ikke hopp hele sider opp og ned i indeksen

# endre hvordan folder-index'en ser ut :)
# http://www.mutt.org/doc/manual/manual-6.html#folder_format
set folder_format="%t%N  %2C %-30f %8s %d "
# hvordan linjene i meldings-index'en skal se ut.
set hdr_format="%4C %Z %{%b %d} %-15.15n (%4l) %s"
# hvordan bunn-linja skal se ut når du leser mail
set pager_format="%S [%T] %n / %s"
# hvordan status-linjen i index-menyen skal se ut
#set status_format="-%r- %f %?n?[ New:%n ]?----%>-(%P)---" 
set status_format = "%r Mutt: %f [Msgs:%?M?%M/?%m%?n? New:%n?%?o? Old:%o?%?d? Del:%d?%?F? Flag:%F?%?t? Tag:%t?%?p? Post:%p?%?b? Inc:%b?%?l? %l?]   (%s/%S) %> (%P)"
color status white blue

# default sortering
set sort=threads
set sort_aux=last-date-received

# farger i index'en
color index     yellow       default ~N      # Ny 
color index     yellow       default ~O      # Gammel, men ulest 
color index     magenta      default ~F      # Flagged
color index     blue         default ~T      # Tagged
color index     red          default ~D      # Deleted

# Transparent background, whooo
color normal		default 	default
color hdrdefault	cyan	 	default
color signature 	cyan	 	default
color attachment 	brightyellow 	default
color quoted 		green 		default
color quoted1 		cyan 		default
color tilde 		blue 		default
color tree		red		default

# Saklig tab-ing (tabber også til unread, ikke bare new)
bind index   \t          next-unread
bind pager   \t          next-unread
bind index  ,\t      previous-unread
bind pager  ,\t      previous-unread

set read_inc=1000 # Speed up opening of large mboxes
set write_inc=1000

set charset=utf-8
set send_charset=utf-8

# highlight git
color body brightred default "^-.*"
color body brightgreen default "^[+].*"
color body brightwhite default "^diff --git.*"
color body brightwhite default "^index [a-f0-9].*"
color body brightyellow default "^@@.*"

macro index \Cr "T~U<enter><tag-prefix><clear-flag>N<untag-pattern>.<enter>" "mark all messages as read"
