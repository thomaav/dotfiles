PATH=/usr/local/bin:/usr/bin:/bin
MAILDIR=$HOME/Mail		# make sure it exists!
DEFAULT=$MAILDIR/		# optional
LOGFILE=$HOME/.procmail-log	# recommended
VERBOSE=on

LOG = "
"

# Catch SPAM
:0
*^X-Spam-Flag: YES
.blerghspam/

:0
* ^(To|CC).*kernelnewbies@kernelnewbies.org
.kernelnewbies/

:0
* ^Subject.*Daily Summary
.lwndaily/

:0
* ^(From).*Twitch*
.twitch/

:0
* ^From.*piazza
.piazza/

:0
* ^(To|Cc|CC).*thomaav@stud.ntnu.no
.ntnu/

:0
* ^From.*do-not-reply@blackboard.com
.ntnu/

:0
* ^(To|Cc|CC).*avensin@hotmail.com
.hotmail/

:0
* ^(To|Cc|CC).*sonopony@gmail.com
.gmail/

:0
*
$DEFAULT
